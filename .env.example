# Compose runtime profile for the benchmark: local or prod.
COMPOSE_PROFILES=local

# Bind PhishGate to localhost only.
PHISHGATE_HOST=127.0.0.1
PHISHGATE_PORT=80

# Gate profile from config/profiles.yaml (baseline, click, interaction, challenge,
# or a single template such as click-alert).
PHISHGATE_PROFILE=click

# Optional suffix for the JSONL log filename.
PHISHGATE_RUN_LABEL=

# Frozen 500-sample cohort, read only by scripts/prepare_experiment.py.
PHISHGATE_COHORT_MANIFEST=/app/config/cohort.csv

# Runtime manifest created by scripts/prepare_experiment.py.
# Leave empty in generic upstream mode.
PHISHGATE_EXPERIMENT_MANIFEST=/app/targets/EVAL/manifest.csv

# Upstream behind the gate. The benchmark default is the PhishDecloaker kit service.
PHISHGATE_UPSTREAM=http://phishdecloaker-kits:80

# Generic upstream mode: gate any single local upstream without the benchmark data.
# PHISHGATE_GENERIC_UPSTREAM=on
# Extra hosts allowed for PHISHGATE_UPSTREAM (comma-separated).
# PHISHGATE_UPSTREAM_ALLOWED_HOSTS=my-app.internal

# Reference seed used in the thesis. It fixes routes, template assignment,
# presentation variants, and challenge content.
PHISHGATE_SEED=731339658

# Hostname style for G1 samples: off, hash, or pronounceable (benchmark default).
# pronounceable requires the /etc/hosts entries from scripts/configure_hosts.py.
PHISHGATE_DOMAIN_STYLE=pronounceable
